# Copy this file to .htaccess on the server (or merge the rewrite block into your live .htaccess).
# CRITICAL: Do NOT add "RewriteCond %{HTTPS} off" — that breaks all inner pages on HTTPS.

RewriteOptions inherit
RewriteEngine on

ErrorDocument 404 /index.php

# if a directory or a file exists, use it directly
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f

# forward everything else to Yii (HTTP and HTTPS)
RewriteCond %{REQUEST_URI} !^/register/
RewriteCond %{QUERY_STRING} !^/register/
RewriteCond %{REQUEST_URI} !^/update/
RewriteCond %{QUERY_STRING} !^/update/
RewriteCond %{REQUEST_URI} !^/packages/
RewriteCond %{QUERY_STRING} !^/packages/
RewriteCond %{REQUEST_URI} !^/upgrade/
RewriteCond %{QUERY_STRING} !^/upgrade/
RewriteCond %{REQUEST_URI} !^/\.well-known/cpanel-dcv/[0-9a-zA-Z_-]+$
RewriteCond %{REQUEST_URI} !^/\.well-known/pki-validation/(?:\ Ballot169)?
RewriteCond %{REQUEST_URI} !^/\.well-known/pki-validation/[A-F0-9]{32}\.txt(?:\ Comodo\ DCV)?$
RewriteRule ^ index.php [L]

# ---- Performance: compression + browser caching (keep these on the live server) ----
# Do NOT add "SetEnv no-gzip" anywhere: it silently switches compression off for the whole site.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/x-javascript application/json application/ld+json application/xml image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
